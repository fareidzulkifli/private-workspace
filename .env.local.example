# Go runtime
APP_ENV=development
APP_BASE_URL=http://localhost:4000
HTTP_ADDR=127.0.0.1:4000
SQLITE_PATH=./data/private-workspace.db
MIGRATIONS_DIR=./migrations
APP_SECRET=replace-with-a-long-random-secret
SESSION_COOKIE_NAME=pw_session
CSRF_HEADER_NAME=X-CSRF-Token
SESSION_TTL_HOURS=168
COOKIE_SECURE=false
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=argon2id$replace-with-hash-from-cmd-hash-password

# SQLite backups
BACKUP_DIR=./backups
BACKUP_TIER=hourly
BACKUP_REPORT_PATH=.docs/backup-report-local.md
R2_BACKUP_PREFIX=backups/private-workspace/local

# Cloudflare R2
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_ENDPOINT=your-r2-endpoint
R2_BUCKET_NAME=your-r2-bucket-name
R2_REGION=auto

# GitHub for GitNote; use a fine-grained PAT with read-only Contents access.
GITHUB_PAT=your-github-personal-access-token
GITHUB_BRANCH=main
GITNOTE_OWNER=fareidzulkifli
GITNOTE_REPO=BA-notes

# Grok API
GROK_API_KEY=your-grok-api-key

# Malaysia holidays
MALAYSIA_HOLIDAY_STATE=kuala-lumpur
