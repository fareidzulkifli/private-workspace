APP_ENV=production
APP_BASE_URL=https://staging-private-workspace.example.com
HTTP_ADDR=127.0.0.1:4000
SQLITE_PATH=/var/lib/private-workspace/private-workspace-staging.db
MIGRATIONS_DIR=/opt/private-workspace/current/migrations
APP_SECRET=replace-with-staging-random-secret
SESSION_COOKIE_NAME=pw_session
CSRF_HEADER_NAME=X-CSRF-Token
SESSION_TTL_HOURS=168
COOKIE_SECURE=true
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=argon2id$replace-with-staging-hash

BACKUP_DIR=/var/backups/private-workspace
BACKUP_TIER=daily
BACKUP_REPORT_PATH=/var/log/private-workspace/backup-report-staging.md
R2_BACKUP_PREFIX=backups/private-workspace/staging

R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_ENDPOINT=https://replace-with-account.r2.cloudflarestorage.com
R2_BUCKET_NAME=replace-with-staging-or-safe-bucket
R2_REGION=auto

GITHUB_PAT=replace-with-read-only-github-token
GITHUB_BRANCH=main
GITNOTE_OWNER=fareidzulkifli
GITNOTE_REPO=BA-notes

GROK_API_KEY=replace-with-grok-api-key
MALAYSIA_HOLIDAY_STATE=kuala-lumpur
